" gruvbox dark, mirroring gruvbox.nvim (default contrast): gui* values are its
" exact palette and highlight groups (Normal, CursorLine, Visual, StatusLine,
" Pmenu, nvim-tree file colors), cterm* values are the nearest 256-color
" fallbacks. vifm only uses gui* when $TERM is a *-direct terminfo entry;
" the `vifm` wrapper in .zshrc and the nvim <leader>e launcher set that up.
"
" palette: bg0 #282828  bg1 #3c3836  bg2 #504945  bg3 #665c54  bg4 #7c6f64
"          fg1 #ebdbb2  fg4 #a89984  red #fb4934  green #b8bb26
"          yellow #fabd2f  blue #83a598  purple #d3869b  aqua #8ec07c

highlight clear

" files (nvim: Normal / Directory / NvimTree*)
highlight Win        cterm=none ctermfg=223 ctermbg=default gui=none guifg=#ebdbb2 guibg=default
highlight Directory  cterm=bold ctermfg=142 ctermbg=default gui=bold guifg=#b8bb26 guibg=default
highlight Link       cterm=none ctermfg=108 ctermbg=default gui=none guifg=#8ec07c guibg=default
highlight BrokenLink cterm=bold ctermfg=167 ctermbg=default gui=bold guifg=#fb4934 guibg=default
highlight HardLink   cterm=none ctermfg=223 ctermbg=default gui=none guifg=#ebdbb2 guibg=default
highlight Socket     cterm=bold ctermfg=175 ctermbg=default gui=bold guifg=#d3869b guibg=default
highlight Device     cterm=bold ctermfg=175 ctermbg=default gui=bold guifg=#d3869b guibg=default
highlight Fifo       cterm=none ctermfg=214 ctermbg=default gui=none guifg=#fabd2f guibg=default
highlight Executable cterm=bold ctermfg=106 ctermbg=default gui=bold guifg=#98971a guibg=default

" cursor and selection (nvim: CursorLine / Visual); fg=default keeps the
" file's own color under the cursor, like CursorLine does in nvim
highlight CurrLine   cterm=none ctermfg=default ctermbg=237 gui=none guifg=default guibg=#3c3836
highlight OtherLine  cterm=none ctermfg=default ctermbg=236 gui=none guifg=default guibg=#32302f
highlight Selected   cterm=none ctermfg=default ctermbg=241 gui=none guifg=default guibg=#665c54
highlight LineNr     cterm=none ctermfg=243 ctermbg=default gui=none guifg=#7c6f64 guibg=default
highlight OddLine    cterm=none ctermfg=default ctermbg=default gui=none guifg=default guibg=default

" bars (nvim: StatusLine / StatusLineNC / TabLine*)
highlight TopLine    cterm=none ctermfg=246 ctermbg=237 gui=none guifg=#a89984 guibg=#3c3836
highlight TopLineSel cterm=bold ctermfg=223 ctermbg=239 gui=bold guifg=#ebdbb2 guibg=#504945
highlight StatusLine cterm=none ctermfg=223 ctermbg=239 gui=none guifg=#ebdbb2 guibg=#504945
highlight JobLine    cterm=none ctermfg=246 ctermbg=237 gui=none guifg=#a89984 guibg=#3c3836
highlight TabLine    cterm=none ctermfg=243 ctermbg=237 gui=none guifg=#7c6f64 guibg=#3c3836
highlight TabLineSel cterm=bold ctermfg=142 ctermbg=237 gui=bold guifg=#b8bb26 guibg=#3c3836
highlight Border     cterm=none ctermfg=241 ctermbg=default gui=none guifg=#665c54 guibg=default

" command line and popups (nvim: Pmenu / WildMenu / ErrorMsg)
highlight CmdLine    cterm=none ctermfg=223 ctermbg=default gui=none guifg=#ebdbb2 guibg=default
highlight ErrorMsg   cterm=bold ctermfg=235 ctermbg=167 gui=bold guifg=#282828 guibg=#fb4934
highlight WildMenu   cterm=bold ctermfg=109 ctermbg=239 gui=bold guifg=#83a598 guibg=#504945
highlight SuggestBox cterm=none ctermfg=223 ctermbg=239 gui=none guifg=#ebdbb2 guibg=#504945
