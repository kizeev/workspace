highlight clear

highlight Win        cterm=none      ctermfg=223  ctermbg=235
highlight Directory  cterm=bold      ctermfg=109  ctermbg=default
highlight Link       cterm=none      ctermfg=142  ctermbg=default
highlight BrokenLink cterm=bold      ctermfg=167  ctermbg=default
highlight HardLink   cterm=none      ctermfg=223  ctermbg=default
highlight Socket     cterm=bold      ctermfg=175  ctermbg=default
highlight Device     cterm=bold      ctermfg=175  ctermbg=default
highlight Fifo       cterm=none      ctermfg=175  ctermbg=default
highlight Executable cterm=bold      ctermfg=142  ctermbg=default
highlight Selected   cterm=bold      ctermfg=235  ctermbg=109
highlight CurrLine   cterm=bold,inverse ctermfg=default ctermbg=default
highlight TopLine    cterm=none      ctermfg=214  ctermbg=236
highlight TopLineSel cterm=bold      ctermfg=214  ctermbg=236
highlight StatusLine cterm=none      ctermfg=223  ctermbg=236
highlight WildMenu   cterm=bold      ctermfg=235  ctermbg=214
highlight CmdLine    cterm=none      ctermfg=223  ctermbg=235
highlight ErrorMsg   cterm=bold      ctermfg=167  ctermbg=235
highlight Border     cterm=none      ctermfg=236  ctermbg=235
highlight JobLine    cterm=none      ctermfg=142  ctermbg=236
highlight SuggestBox cterm=none      ctermfg=223  ctermbg=236
highlight TabLine    cterm=none      ctermfg=223  ctermbg=236
highlight TabLineSel cterm=bold      ctermfg=214  ctermbg=235
highlight OtherLine  cterm=none      ctermfg=223  ctermbg=234
highlight LineNr     cterm=none      ctermfg=241  ctermbg=default
highlight OddLine    cterm=none      ctermfg=default ctermbg=default
